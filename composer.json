{
  "name": "elcreator/aimage",
  "description": "AIMage — an AI image workbench for the Evolution CMS manager: describe a batch of image work in text or by voice, let a text model plan it, and let a cross-server worker carry it out against ai.artur.work while you are away.",
  "type": "evolutioncms-plugin",
  "keywords": ["evo", "evocms", "evolution", "evolution-cms", "ai", "image", "batch", "upscale", "generation"],
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "evolution-cms/evolution": "^3.5.2",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Elcreator\\aIMage\\": "src/"
    }
  },
  "scripts": {
    "test": "pest --no-coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Elcreator\\aIMage\\aIMageServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
